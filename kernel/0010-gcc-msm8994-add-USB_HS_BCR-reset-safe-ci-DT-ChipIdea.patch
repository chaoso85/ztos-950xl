From d885626e478b7506fbb564fda2346035719d79e9 Mon Sep 17 00:00:00 2001
From: chaoso85 <216391968+chaoso85@users.noreply.github.com>
Date: Sat, 7 Nov 2026 20:37:29 +0000
Subject: [PATCH] gcc-msm8994: add USB_HS_BCR reset; safe-ci DT: ChipIdea
 reg/reset

Signed-off-by: chaoso85 <216391968+chaoso85@users.noreply.github.com>
---
 .../dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-ci.dts   | 4 +++-
 drivers/clk/qcom/gcc-msm8994.c                                | 1 +
 include/dt-bindings/clock/qcom,gcc-msm8994.h                  | 1 +
 3 files changed, 5 insertions(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-ci.dts b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-ci.dts
index 834545f94c9..4cb809c3ccb 100644
--- a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-ci.dts
+++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-ci.dts
@@ -20,11 +20,13 @@ hs_xceiv: usb-nop-xceiv {
 	soc@0 {
 		usb_hs: usb@f9a55000 {
 			compatible = "qcom,ci-hdrc";
-			reg = <0xf9a55000 0x400>;
+			reg = <0xf9a55000 0x200>, <0xf9a55200 0x200>;
 			interrupts = <GIC_SPI 134 IRQ_TYPE_LEVEL_HIGH>;
 			clocks = <&gcc GCC_USB_HS_SYSTEM_CLK>,
 				 <&gcc GCC_USB_HS_AHB_CLK>;
 			clock-names = "core", "iface";
+			resets = <&gcc GCC_USB_HS_BCR>;
+			reset-names = "core";
 			dr_mode = "peripheral";
 			phy_type = "ulpi";
 			usb-phy = <&hs_xceiv>;
diff --git a/drivers/clk/qcom/gcc-msm8994.c b/drivers/clk/qcom/gcc-msm8994.c
index 1978e5c9105..c229fa1ce3b 100644
--- a/drivers/clk/qcom/gcc-msm8994.c
+++ b/drivers/clk/qcom/gcc-msm8994.c
@@ -2631,6 +2631,7 @@ static const struct qcom_reset_map gcc_msm8994_resets[] = {
 	[PCIE_PHY_1_RESET] = { 0x1b98 },
 	[QUSB2_PHY_RESET] = { 0x04b8 },
 	[USB2_HS_PHY_SLEEP_ARES] = { 0x04ac, 2 },
+	[GCC_USB_HS_BCR] = { 0x0480 },
 };
 
 static const struct regmap_config gcc_msm8994_regmap_config = {
diff --git a/include/dt-bindings/clock/qcom,gcc-msm8994.h b/include/dt-bindings/clock/qcom,gcc-msm8994.h
index 7cdccfb5cb5..0a22e151665 100644
--- a/include/dt-bindings/clock/qcom,gcc-msm8994.h
+++ b/include/dt-bindings/clock/qcom,gcc-msm8994.h
@@ -176,5 +176,6 @@
 #define QUSB2_PHY_RESET			4
 #define MSS_RESET				5
 #define USB2_HS_PHY_SLEEP_ARES		6
+#define GCC_USB_HS_BCR			7
 
 #endif
-- 
2.43.0

