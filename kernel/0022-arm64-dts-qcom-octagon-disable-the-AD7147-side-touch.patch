From 0a20f249dd622f4ef57397c0835665fe84f4d8a7 Mon Sep 17 00:00:00 2001
From: chaoso85 <216391968+chaoso85@users.noreply.github.com>
Date: Sun, 8 Nov 2026 21:13:33 +0000
Subject: [PATCH 2/2] arm64: dts: qcom: octagon: disable the AD7147 side touch
 node

Part of the reference project used: msm8994-msft-lumia-octagon.dtsi sideinteraction node (kept, only disabled).
Before: drivers/input/misc/ad714x.c has no DT support (needs board platform data), so the probe always failed
with 'platform data for ad714x doesn't exist' (-EINVAL); 0019 only fixed its interrupt property.

Signed-off-by: chaoso85 <216391968+chaoso85@users.noreply.github.com>
---
 arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi | 5 +++++
 1 file changed, 5 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
index b709b073739..e1f1f029d79 100644
--- a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
@@ -636,6 +636,11 @@ &blsp2_i2c1 {
 	sideinteraction: touch@2c {
 		compatible = "adi,ad7147_captouch";
 		reg = <0x2c>;
+		/*
+		 * drivers/input/misc/ad714x.c only takes board platform data
+		 * (dev_get_platdata), it has no DT binding: probe fails -EINVAL.
+		 */
+		status = "disabled";
 
 		pinctrl-names = "default", "sleep";
 		pinctrl-0 = <&grip_default>;
-- 
2.43.0

