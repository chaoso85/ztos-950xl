From 70b1eac4d0ff1f119fb8b5e2c970d51917711350 Mon Sep 17 00:00:00 2001
From: chaoso85 <216391968+chaoso85@users.noreply.github.com>
Date: Tue, 10 Nov 2026 11:35:47 +0000
Subject: [PATCH] thermal/qcom: tsens: add MSM8994 (v0.1 IP, 16 sensors), DT
 node and read-only thermal zones

Reference used: downstream drivers/thermal/msm8974-tsens.c (tsens_calib_8994_sensors:
calibration words at QFPROM 0xfc4bc000 + 0xd0, per-sensor offsets, sensor numbering
from qcom,sensor-information). Before, the SoC temperature sensors were not
exposed at all (only the PMIC die and the battery), so the CPU/GPU temperature could
not be watched while raising clocks. Mainline tsens-v0_1 handles up to 11 sensors; this
adds a 16-sensor regfield set, the 8994 calibration read through ioremap (like the stock
DSDT reads its speed bin from the same alias) and thermal zones for cpu0..7 and the gpu.
The secure firmware has already started the sensors although the SROT TSENS_EN bit reads 0,
so the probe no longer refuses on that bit (new feature flag skip_en_check). Sensors 0..4
read code 0 (not connected) and get no zone. No cooling policy yet.

Signed-off-by: chaoso85 <216391968+chaoso85@users.noreply.github.com>
---
 arch/arm64/boot/dts/qcom/msm8994.dtsi | 159 ++++++++++++++++++++++++++
 drivers/thermal/qcom/tsens-v0_1.c     |  93 +++++++++++++++
 drivers/thermal/qcom/tsens.c          |   5 +-
 drivers/thermal/qcom/tsens.h          |   5 +-
 4 files changed, 260 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8994.dtsi b/arch/arm64/boot/dts/qcom/msm8994.dtsi
index e77011e9ab1..cd4761e7cfd 100644
--- a/arch/arm64/boot/dts/qcom/msm8994.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8994.dtsi
@@ -933,6 +933,16 @@ rpm_msg_ram: sram@fc428000 {
 			reg = <0xfc428000 0x4000>;
 		};
 
+		tsens: thermal-sensor@fc4a9000 {
+			compatible = "qcom,msm8994-tsens";
+			reg = <0xfc4a9000 0x1000>, /* TM */
+			      <0xfc4a8000 0x1000>; /* SROT */
+			#qcom,sensors = <16>;
+			interrupts = <GIC_SPI 184 IRQ_TYPE_LEVEL_HIGH>;
+			interrupt-names = "uplow";
+			#thermal-sensor-cells = <1>;
+		};
+
 		bimc: interconnect@fc380000 {
 			reg = <0xfc380000 0x80000>;
 			compatible = "qcom,msm8994-bimc";
@@ -1874,6 +1884,155 @@ q6routing: routing {
 
 	};
 
+	/*
+	 * TSENS sensor numbering from the downstream qcom,sensor-information: 7..10 = A53 cpu0..3, 13/14/15/6 = A57 cpu4..7,
+	 * 12 = gpu. Sensors 0..4 read as code 0 (not connected) and 5, 11 have no known owner. No cooling policy yet: read-only monitoring until a thermal policy exists.
+	 */
