 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-ci.dts b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-ci.dts
