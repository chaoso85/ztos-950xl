From d06ef423de1ef3db23de3d64806c1e1fda4d78bc Mon Sep 17 00:00:00 2001
From: chaoso85 <216391968+chaoso85@users.noreply.github.com>
Date: Sun, 8 Nov 2026 21:13:33 +0000
Subject: [PATCH 1/2] clk: skip the CLK_OPS_PARENT_ENABLE dance when
 reparenting orphans

Part of the reference project used: none (generic clk core; triggered by our patch 0018 that set
CLK_OPS_PARENT_ENABLE on the MSM8994 byte/pclk RCGs).
Before: when the DSI PHY registered its PLL clocks, clk_core_reparent_orphans_nolock() ran
__clk_set_parent_before/after on the orphan RCGs. With CLK_OPS_PARENT_ENABLE that prepare_enables the new
parent (dsi0pll/dsi0pllbyte), which fails because the 20nm VCO has no rate yet (-EINVAL), the error is
ignored and the matching disable_unprepare WARNs 'already disabled/unprepared' (6 WARNs per boot).
No .set_parent hardware op runs during orphan reparenting, so the parent enable is not needed there.

Signed-off-by: chaoso85 <216391968+chaoso85@users.noreply.github.com>
---
 drivers/clk/clk.c | 12 ++++++++++++
 1 file changed, 12 insertions(+)

diff --git a/drivers/clk/clk.c b/drivers/clk/clk.c
index fef87167a60..11b4acb71cd 100644
--- a/drivers/clk/clk.c
+++ b/drivers/clk/clk.c
@@ -3941,9 +3941,21 @@ static void clk_core_reparent_orphans_nolock(void)
 		 * are enabled during init but might not have a parent yet.
 		 */
 		if (parent) {
+			unsigned long saved_flags = orphan->flags;
+
+			/*
+			 * No .set_parent hardware op runs here, so the
+			 * CLK_OPS_PARENT_ENABLE enable/disable of the parents is
+			 * not needed. It is also unbalanced: the parent may not be
+			 * preparable yet (e.g. a DSI PLL whose PHY is not powered),
+			 * clk_core_prepare_enable() then fails silently and the
+			 * matching disable_unprepare() WARNs "already disabled".
+			 */
+			orphan->flags &= ~CLK_OPS_PARENT_ENABLE;
 			/* update the clk tree topology */
 			__clk_set_parent_before(orphan, parent);
 			__clk_set_parent_after(orphan, parent, NULL);
+			orphan->flags = saved_flags;
 			__clk_recalc_accuracies(orphan);
 			__clk_recalc_rates(orphan, true, 0);
 
