From de03bec4f854221c325f9a38a82c4a2deed693ac Mon Sep 17 00:00:00 2001
From: chaoso85 <216391968+chaoso85@users.noreply.github.com>
Date: Tue, 10 Nov 2026 01:26:51 +0000
Subject: [PATCH] power: reset: qcom-pon: optional PS_HOLD warm reset
 (qcom_pon.ps_hold_warm=1) to keep ramoops

Part of the reference project used: msm-3.10 drivers/platform/msm/qpnp-power-on.c qpnp_pon_set_restart /
qpnp_config_reset (PS_HOLD_RST_CTL 0x5a, CTL2 0x5b bit 7, warm reset type 0x1).
Before: the TZ PS_HOLD reset on the FULL DT is a hard reset, DDR is lost, the ramoops console of the dying boot
was always empty, and the reset happens before init (no SD log), so there was no log of it at all.

Signed-off-by: chaoso85 <216391968+chaoso85@users.noreply.github.com>
---
 drivers/power/reset/qcom-pon.c | 26 ++++++++++++++++++++++++++
 1 file changed, 26 insertions(+)

diff --git a/drivers/power/reset/qcom-pon.c b/drivers/power/reset/qcom-pon.c
index b43ec3f2a8c..9e063467d99 100644
--- a/drivers/power/reset/qcom-pon.c
+++ b/drivers/power/reset/qcom-pon.c
@@ -44,6 +44,10 @@ static int qcom_pon_reboot_mode_write(struct reboot_mode_driver *reboot,
 	return ret;
 }
 
+static bool ps_hold_warm;
+module_param(ps_hold_warm, bool, 0444);
+MODULE_PARM_DESC(ps_hold_warm, "make a PS_HOLD reset a PMIC warm reset (keeps DDR/ramoops)");
+
 static int qcom_pon_probe(struct platform_device *pdev)
 {
 	struct qcom_pon *pon;
@@ -82,6 +86,28 @@ static int qcom_pon_probe(struct platform_device *pdev)
 				 r[0], r[2], r[3], r[4], r[5], r[6], r[7], r[1]);
 	}
 
+	/*
+	 * ztOS bring-up: qcom_pon.ps_hold_warm=1 makes a PS_HOLD drop (TZ/software reset) a PMIC WARM reset
+	 * instead of a hard reset, so DDR (and the ramoops console of the dying boot) survives it. Gen1 PON:
+	 * PS_HOLD_RESET_CTL 0x5a (type, 0x1 = warm reset), PS_HOLD_RESET_CTL2 0x5b (bit 7 = enable); the enable
+	 * bit must be cleared for >= 10 sleep-clock cycles while the type changes (msm-3.10 qpnp-power-on.c).
+	 */
+	if (ps_hold_warm) {
+		unsigned int ctl = 0, ctl2 = 0;
+
+		regmap_read(pon->regmap, pon->baseaddr + 0x5a, &ctl);
+		regmap_read(pon->regmap, pon->baseaddr + 0x5b, &ctl2);
+		error = regmap_update_bits(pon->regmap, pon->baseaddr + 0x5b, BIT(7), 0);
+		usleep_range(1000, 2000);
+		if (!error)
+			error = regmap_update_bits(pon->regmap, pon->baseaddr + 0x5a, 0x0f, 0x01);
+		error |= regmap_update_bits(pon->regmap, pon->baseaddr + 0x5b, BIT(7), BIT(7));
+		dev_info(&pdev->dev, "PS_HOLD reset: ctl %02x ctl2 %02x -> warm reset (%d)\n", ctl, ctl2, error);
+		regmap_read(pon->regmap, pon->baseaddr + 0x5a, &ctl);
+		regmap_read(pon->regmap, pon->baseaddr + 0x5b, &ctl2);
+		dev_info(&pdev->dev, "PS_HOLD reset now: ctl %02x ctl2 %02x\n", ctl, ctl2);
+	}
+
 	reason_shift = (long)of_device_get_match_data(&pdev->dev);
 
 	if (reason_shift != NO_REASON_SHIFT) {
-- 
2.43.0

