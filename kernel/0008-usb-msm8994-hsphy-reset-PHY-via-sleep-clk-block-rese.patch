From ef20ca3e576c69e5aeecc2c9f2797eabe9b4ce19 Mon Sep 17 00:00:00 2001
From: chaoso85 <216391968+chaoso85@users.noreply.github.com>
Date: Sat, 7 Nov 2026 20:03:52 +0000
Subject: [PATCH] usb: msm8994 hsphy: reset PHY via sleep-clk block reset (gcc
 reset 6)

Signed-off-by: chaoso85 <216391968+chaoso85@users.noreply.github.com>
---
 arch/arm64/boot/dts/qcom/msm8994.dtsi        |  2 ++
 drivers/clk/qcom/gcc-msm8994.c               |  1 +
 drivers/usb/phy/phy-msm8994-hsusb.c          | 14 ++++++++++++++
 include/dt-bindings/clock/qcom,gcc-msm8994.h |  1 +
 4 files changed, 18 insertions(+)

diff --git a/arch/arm64/boot/dts/qcom/msm8994.dtsi b/arch/arm64/boot/dts/qcom/msm8994.dtsi
index 803e892e601..4c5c099c804 100644
--- a/arch/arm64/boot/dts/qcom/msm8994.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8994.dtsi
@@ -482,6 +482,8 @@ usb3_hsphy: phy@f9b3a000 {
 			reg-names = "csr", "qscratch";
 			clocks = <&gcc GCC_USB2_HS_PHY_SLEEP_CLK>;
 			clock-names = "sleep";
+			resets = <&gcc USB2_HS_PHY_SLEEP_ARES>;
+			reset-names = "sleep";
 			#phy-cells = <0>;
 			status = "disabled";
 		};
diff --git a/drivers/clk/qcom/gcc-msm8994.c b/drivers/clk/qcom/gcc-msm8994.c
index 6a6b7da2b15..1978e5c9105 100644
--- a/drivers/clk/qcom/gcc-msm8994.c
+++ b/drivers/clk/qcom/gcc-msm8994.c
@@ -2630,6 +2630,7 @@ static const struct qcom_reset_map gcc_msm8994_resets[] = {
 	[PCIE_PHY_0_RESET] = { 0x1b18 },
 	[PCIE_PHY_1_RESET] = { 0x1b98 },
 	[QUSB2_PHY_RESET] = { 0x04b8 },
+	[USB2_HS_PHY_SLEEP_ARES] = { 0x04ac, 2 },
 };
 
 static const struct regmap_config gcc_msm8994_regmap_config = {
diff --git a/drivers/usb/phy/phy-msm8994-hsusb.c b/drivers/usb/phy/phy-msm8994-hsusb.c
index cdbb2e831af..5697b6ba9f7 100644
--- a/drivers/usb/phy/phy-msm8994-hsusb.c
+++ b/drivers/usb/phy/phy-msm8994-hsusb.c
@@ -15,6 +15,8 @@
 #include <linux/of_address.h>
 #include <linux/platform_device.h>
 #include <linux/regulator/consumer.h>
+#include <linux/reset.h>
+#include <linux/delay.h>
 #include <linux/usb/phy.h>
 
 /* QSCRATCH offsets */
@@ -42,6 +44,7 @@ struct msm8994_hsphy {
 	struct usb_phy phy;
 	void __iomem *qscratch;
 	struct clk *sleep_clk;
+	struct reset_control *sleep_rst;
 	struct regulator *vdda18;
 	struct regulator *vdda33;
 	u32 init_seq;
@@ -53,6 +56,13 @@ static int msm8994_hsphy_init(struct usb_phy *uphy)
 	struct msm8994_hsphy *p = container_of(uphy, struct msm8994_hsphy, phy);
 	u32 val, core_ver;
 
+	if (p->sleep_rst) {
+		reset_control_assert(p->sleep_rst);
+		usleep_range(10, 20);
+		reset_control_deassert(p->sleep_rst);
+		usleep_range(100, 200);
+	}
+
 	dev_info(uphy->dev, "init: step1 HS_PHY_CTRL\n");
 	val = readl(p->qscratch + HS_PHY_CTRL);
 	val |= HS_USB2_UTMI_CLK_EN | HS_CLAMP_MPM_DPSE_DMSE_EN_N |
@@ -119,6 +129,10 @@ static int msm8994_hsphy_probe(struct platform_device *pdev)
 	if (IS_ERR(p->sleep_clk))
 		return dev_err_probe(dev, PTR_ERR(p->sleep_clk), "sleep clk\n");
 
+	p->sleep_rst = devm_reset_control_get_optional_exclusive(dev, "sleep");
+	if (IS_ERR(p->sleep_rst))
+		return dev_err_probe(dev, PTR_ERR(p->sleep_rst), "sleep reset\n");
+
 	dev_info(dev, "probe: sleep clk on, enabling regulators\n");
 	ret = regulator_set_load(p->vdda18, 19000);
 	if (ret < 0)
diff --git a/include/dt-bindings/clock/qcom,gcc-msm8994.h b/include/dt-bindings/clock/qcom,gcc-msm8994.h
index f6836f430bb..7cdccfb5cb5 100644
--- a/include/dt-bindings/clock/qcom,gcc-msm8994.h
+++ b/include/dt-bindings/clock/qcom,gcc-msm8994.h
@@ -175,5 +175,6 @@
 #define PCIE_PHY_1_RESET		3
 #define QUSB2_PHY_RESET			4
 #define MSS_RESET				5
+#define USB2_HS_PHY_SLEEP_ARES		6
 
 #endif
-- 
2.43.0

