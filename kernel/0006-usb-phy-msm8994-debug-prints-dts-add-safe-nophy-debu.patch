From c848c21673226ef5175cd0eb973dce7987486772 Mon Sep 17 00:00:00 2001
From: chaoso85 <216391968+chaoso85@users.noreply.github.com>
Date: Sat, 7 Nov 2026 19:46:05 +0000
Subject: [PATCH] usb: phy: msm8994 debug prints; dts: add safe-nophy debug DTB

---
 arch/arm64/boot/dts/qcom/Makefile                          | 1 +
 .../qcom/msm8994-msft-lumia-octagon-cityman-safe-nophy.dts | 6 ++++++
 drivers/usb/phy/phy-msm8994-hsusb.c                        | 7 +++++++
 3 files changed, 14 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-nophy.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index d55af152754..a40c67089e2 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -136,6 +136,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= msm8992-xiaomi-libra.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-huawei-angler-rev-101.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-msft-lumia-octagon-cityman.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-msft-lumia-octagon-cityman-safe.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-msft-lumia-octagon-cityman-safe-nophy.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-sony-xperia-kitakami-ivy.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-sony-xperia-kitakami-karin.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-sony-xperia-kitakami-satsuki.dtb
diff --git a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-nophy.dts b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-nophy.dts
new file mode 100644
index 00000000000..a602eb6f494
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-nophy.dts
@@ -0,0 +1,6 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/* Debug: SAFE DTB without the new HS PHY driver (isolates PHY init hangs). */
+#include "msm8994-msft-lumia-octagon-cityman-safe.dts"
+
+&usb3_hsphy { status = "disabled"; };
+&usb3_dwc3 { /delete-property/ usb-phy; };
diff --git a/drivers/usb/phy/phy-msm8994-hsusb.c b/drivers/usb/phy/phy-msm8994-hsusb.c
index bbe43c3f59d..cdbb2e831af 100644
--- a/drivers/usb/phy/phy-msm8994-hsusb.c
+++ b/drivers/usb/phy/phy-msm8994-hsusb.c
@@ -53,13 +53,16 @@ static int msm8994_hsphy_init(struct usb_phy *uphy)
 	struct msm8994_hsphy *p = container_of(uphy, struct msm8994_hsphy, phy);
 	u32 val, core_ver;
 
+	dev_info(uphy->dev, "init: step1 HS_PHY_CTRL\n");
 	val = readl(p->qscratch + HS_PHY_CTRL);
 	val |= HS_USB2_UTMI_CLK_EN | HS_CLAMP_MPM_DPSE_DMSE_EN_N |
 	       HS_RETENABLEN;
 	writel(val, p->qscratch + HS_PHY_CTRL);
 	usleep_range(2000, 2200);
 
+	dev_info(uphy->dev, "init: step2 core version\n");
 	core_ver = readl(p->qscratch);
+	dev_info(uphy->dev, "init: core ver %#x\n", core_ver);
 	if (core_ver >= MSM_CORE_VER_120) {
 		val = readl(p->qscratch + HS_PHY_CTRL_COMMON);
 		val |= COMMON_OTGDISABLE0 | COMMON_OTGTUNE0_DEFAULT |
@@ -72,6 +75,7 @@ static int msm8994_hsphy_init(struct usb_phy *uphy)
 		writel(val, p->qscratch + HS_PHY_CTRL_COMMON);
 	}
 
+	dev_info(uphy->dev, "init: step3 override\n");
 	if (p->init_seq) {
 		val = readl(p->qscratch + PARAMETER_OVERRIDE_X);
 		val &= ~PARAM_OVERRIDE_MASK;
@@ -103,6 +107,7 @@ static int msm8994_hsphy_probe(struct platform_device *pdev)
 	if (!p->qscratch)
 		return -ENOMEM;
 
+	dev_info(dev, "probe: start\n");
 	p->vdda18 = devm_regulator_get(dev, "vdda18");
 	if (IS_ERR(p->vdda18))
 		return dev_err_probe(dev, PTR_ERR(p->vdda18), "vdda18\n");
@@ -114,6 +119,7 @@ static int msm8994_hsphy_probe(struct platform_device *pdev)
 	if (IS_ERR(p->sleep_clk))
 		return dev_err_probe(dev, PTR_ERR(p->sleep_clk), "sleep clk\n");
 
+	dev_info(dev, "probe: sleep clk on, enabling regulators\n");
 	ret = regulator_set_load(p->vdda18, 19000);
 	if (ret < 0)
 		return ret;
@@ -141,6 +147,7 @@ static int msm8994_hsphy_probe(struct platform_device *pdev)
 	p->phy.type = USB_PHY_TYPE_USB2;
 
 	platform_set_drvdata(pdev, p);
+	dev_info(dev, "probe: registering phy\n");
 	return usb_add_phy_dev(&p->phy);
 }
 
-- 
2.43.0

