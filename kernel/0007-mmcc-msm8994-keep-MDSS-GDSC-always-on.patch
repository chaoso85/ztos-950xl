From: chaoso85 <216391968+chaoso85@users.noreply.github.com>
Date: Sat, 7 Nov 2026 19:51:04 +0000
Subject: [PATCH] mmcc-msm8994: keep MDSS GDSC always on

Signed-off-by: chaoso85 <216391968+chaoso85@users.noreply.github.com>
---
 drivers/clk/qcom/mmcc-msm8994.c | 3 ++-
 1 file changed, 2 insertions(+), 1 deletion(-)

diff --git a/drivers/clk/qcom/mmcc-msm8994.c b/drivers/clk/qcom/mmcc-msm8994.c
index c233699a47b..ef37f7528b5 100644
--- a/drivers/clk/qcom/mmcc-msm8994.c
+++ b/drivers/clk/qcom/mmcc-msm8994.c
@@ -2319,9 +2319,10 @@ static struct gdsc mdss_gdsc = {
 	.cxc_count = 2,
 	.pd = {
 		.name = "mdss_gdsc",
-		.flags = GENPD_FLAG_NO_STAY_ON,
 	},
 	.pwrsts = PWRSTS_OFF_ON,
+	/* UEFI-initialised display scans out of this domain; keep it on */
+	.flags = ALWAYS_ON,
 };
 
 static struct gdsc camss_top_gdsc = {
