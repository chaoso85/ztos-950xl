From b1cb71f77a02b0dda6007f5db47d4f8207d0c427 Mon Sep 17 00:00:00 2001
From: chaoso85 <216391968+chaoso85@users.noreply.github.com>
Date: Sat, 7 Nov 2026 20:30:32 +0000
Subject: [PATCH] dts: add safe-ci debug DTB (ChipIdea HS USB gadget)

Signed-off-by: chaoso85 <216391968+chaoso85@users.noreply.github.com>
---
 arch/arm64/boot/dts/qcom/Makefile             |  1 +
 ...994-msft-lumia-octagon-cityman-safe-ci.dts | 35 +++++++++++++++++++
 2 files changed, 36 insertions(+)
 create mode 100644 arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-ci.dts

diff --git a/arch/arm64/boot/dts/qcom/Makefile b/arch/arm64/boot/dts/qcom/Makefile
index a40c67089e2..b214ada575d 100644
--- a/arch/arm64/boot/dts/qcom/Makefile
+++ b/arch/arm64/boot/dts/qcom/Makefile
@@ -137,6 +137,7 @@ dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-huawei-angler-rev-101.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-msft-lumia-octagon-cityman.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-msft-lumia-octagon-cityman-safe.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-msft-lumia-octagon-cityman-safe-nophy.dtb
+dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-msft-lumia-octagon-cityman-safe-ci.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-sony-xperia-kitakami-ivy.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-sony-xperia-kitakami-karin.dtb
 dtb-$(CONFIG_ARCH_QCOM)	+= msm8994-sony-xperia-kitakami-satsuki.dtb
diff --git a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-ci.dts b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-ci.dts
new file mode 100644
index 00000000000..834545f94c9
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon-cityman-safe-ci.dts
@@ -0,0 +1,35 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Debug: SAFE DTB that uses the ChipIdea HS USB core (0xf9a55000, the one the
+ * stock UEFI/Windows device mode uses) instead of DWC3 for the gadget.
+ */
+#include "msm8994-msft-lumia-octagon-cityman-safe.dts"
+#include <dt-bindings/clock/qcom,gcc-msm8994.h>
+#include <dt-bindings/interrupt-controller/arm-gic.h>
+
+&usb3_dwc3 { status = "disabled"; };
+&usb3_hsphy { status = "disabled"; };
+
+/ {
+	hs_xceiv: usb-nop-xceiv {
+		compatible = "usb-nop-xceiv";
+		vcc-supply = <&vreg_l24a_3p075>;
+		#phy-cells = <0>;
+	};
+
+	soc@0 {
+		usb_hs: usb@f9a55000 {
+			compatible = "qcom,ci-hdrc";
+			reg = <0xf9a55000 0x400>;
+			interrupts = <GIC_SPI 134 IRQ_TYPE_LEVEL_HIGH>;
+			clocks = <&gcc GCC_USB_HS_SYSTEM_CLK>,
+				 <&gcc GCC_USB_HS_AHB_CLK>;
+			clock-names = "core", "iface";
+			dr_mode = "peripheral";
+			phy_type = "ulpi";
+			usb-phy = <&hs_xceiv>;
+			ahb-burst-config = <0>;
+			status = "okay";
+		};
+	};
+};
-- 
