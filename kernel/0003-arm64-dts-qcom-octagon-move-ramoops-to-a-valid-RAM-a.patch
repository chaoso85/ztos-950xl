From eb8f4aba1e468c3b37fe96e0b8832f2d8a512df5 Mon Sep 17 00:00:00 2001
From: chaoso85 <216391968+chaoso85@users.noreply.github.com>
Date: Sat, 7 Nov 2026 18:50:34 +0000
Subject: [PATCH] arm64: dts: qcom: octagon: move ramoops to a valid RAM
 address

---
 .../boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi      | 10 ++++++++--
 1 file changed, 8 insertions(+), 2 deletions(-)

diff --git a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
index ce5251a21b2..aad4e7bdd85 100644
--- a/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
+++ b/arch/arm64/boot/dts/qcom/msm8994-msft-lumia-octagon.dtsi
@@ -306,9 +306,15 @@ cnss_mem: memory@ef00000 {
 			no-map;
 		};
 
-		ramoops@d9d00000 {
+		/*
+		 * Persistent log buffer. Placed right after the PIL/cnss carve-outs
+		 * (known RAM, outside the TZ/modem regions). The previous address
+		 * 0xd9d00000 came from the lk2nd layout and is not valid RAM here.
+		 */
+		ramoops@f200000 {
 			compatible = "ramoops";
-			reg = <0x0 0xd9d00000 0x0 0x100000>;
+			reg = <0x0 0x0f200000 0x0 0x100000>;
+			no-map;
 			record-size = <0x20000>;
 			console-size = <0x80000>;
 			pmsg-size = <0x20000>;
-- 
2.43.0

